# ============================================================
#  Root .gitignore — GH_site
# ============================================================

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Lockfiles (по решению владельца в гите не держим) ---
package-lock.json
**/package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Build outputs ---
dist/
build/
**/dist/
**/build/

# --- Env / editor ---
.vscode/launch.json

# --- Logs / backups / bak ---
*.log
*.bak
visual-cms/backups/

# --- Ad-hoc SQL (скретч-запросы). Миграции — исходники, НЕ игнорировать. ---
*.sql
!**/migrations/*.sql

# --- Ad-hoc TXT ---
*.txt

# --- Скретч-дампы CMS (разовые выгрузки структуры/биндингов) ---
visual-cms/bindings.json
visual-cms/section-structure.json
visual-cms/page-struct-full.json
visual-cms/template-block.json
visual-cms/template-struct.json
visual-cms/gh-latest.html
visual-cms/hero.json
.tmp_binding_update.json
.tmp_residential_structure.json
api_resp.json
lol.html

# --- Разовые скрипты/утилиты ---
strip-html.js
inspect-hero.js
visual-cms/scripts/*
visual-cms/backend/scripts/*
visual-cms/backend/fix_rce.js
visual-cms/backend/fix_rce2.js
visual-cms/backend/fix_rce3.js

# jest.config.js бэкенда намеренно не в гите (генерится/локальный)
visual-cms/backend/jest.config.js

# --- Сгенерированная статика / крупные бинарники / исходный сайт ---
visual-cms/public-site/*
test.html
gh-export/*
gh-export.rar
Сайт Голден хаус/*
Интеграция с сайтом _ Документация MACRO.html

# --- Прочее ---
visual-cms/docs/data-binding-system-spec.md
CLAUDE.md
