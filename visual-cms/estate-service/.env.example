# estate-service configuration

# HTTP port (compose maps 5100:5100)
PORT=5100

# Own PostgreSQL database (isolated from CMS visual_cms DB).
# В docker-compose поднимается БД `estate` на том же postgres-контейнере.
DATABASE_URL=postgresql://cms_user:cms_password@postgres:5432/estate

NODE_ENV=development
LOG_LEVEL=info

# Shared secret required for write endpoints (POST/PUT/DELETE).
# Чтение (GET) открыто во внутренней сети (DataSource server-fetch).
# Записи (админка CMS) должны присылать заголовок X-Estate-Token с этим значением.
# На проде задать длинный случайный. Пусто = запись запрещена полностью.
ESTATE_WRITE_TOKEN=dev-estate-write-token-change-me

# CORS origins для админки (CMS-фронт). Через запятую.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173