# news-service configuration

# HTTP port (compose maps 5200:5200)
PORT=5200

# Own PostgreSQL database (isolated from CMS visual_cms DB).
# В docker-compose создаётся автоматически на том же postgres-контейнере.
DATABASE_URL=postgresql://cms_user:cms_password@postgres:5432/news

NODE_ENV=development
LOG_LEVEL=info

# Shared secret required for write endpoints (POST/PUT/DELETE).
# Чтение (GET /api/news…) открыто во внутренней сети (DataSource server-fetch),
# публичная лента (/api/public/…) отдаётся наружу через nginx.
# Записи (админка CMS, отчёт CMS о деплое) присылают заголовок X-News-Token.
# На проде задать длинный случайный. Пусто = запись запрещена полностью.
NEWS_WRITE_TOKEN=dev-news-write-token-change-me

# CORS origins для админки (CMS-фронт). Через запятую.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
