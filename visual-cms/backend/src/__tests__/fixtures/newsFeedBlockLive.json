 "metadata": {
  "name": "News feed",
  "globalJs": "/* Блок: Лента новостей с фильтром — block-уровень globalJs.\n   Фильтрует карточки по типу (Все / Акции / Новости). Если на странице нет\n   фильтров — тихо выходит, поэтому блок безопасен где угодно. */\n(() => {\n  const init = () => {\n    const filters = document.querySelectorAll(\"[data-news-filter]\");\n    const cards = document.querySelectorAll(\"[data-news-type]\");\n    if (!filters.length) return;\n\n    const applyFilter = (filter) => {\n      filters.forEach((button) => {\n        button.classList.toggle(\"active\", button.dataset.newsFilter === filter);\n      });\n\n      cards.forEach((card) => {\n        card.classList.toggle(\"is-hidden\", filter !== \"all\" && card.dataset.newsType !== filter);\n      });\n    };\n\n    filters.forEach((button) => {\n      button.addEventListener(\"click\", () => applyFilter(button.dataset.newsFilter));\n    });\n\n    if (window.location.hash === \"#offers\") {\n      applyFilter(\"offer\");\n    }\n  };\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", init);\n  } else {\n    init();\n  }\n})();",
  "globalCss": "/* Блок: Лента новостей с фильтром — block-уровень globalCss. */\n\n.news-toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: clamp(22px, 3vw, 36px);\n}\n\n.news-filter.active {\n  border-color: rgba(253, 184, 42, .9);\n  background: var(--gold);\n  color: var(--ink);\n  box-shadow: 0 14px 32px rgba(253, 184, 42, .28);\n}\n\n.news-card.is-hidden {\n  display: none;\n}\n\n.news-media img {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  transition: transform .35s ease;\n}\n\n.news-card:hover .news-media img {\n  transform: scale(1.035);\n}\n\n.news-body h2 {\n  margin-top: 10px;\n  font-size: clamp(24px, 2vw, 34px);\n  line-height: 1.08;\n  letter-spacing: 0;\n}\n\n.news-body p {\n  margin-top: 14px;\n  color: var(--muted);\n  font-size: 16px;\n  line-height: 1.5;\n}\n\n.news-tags span {\n  padding: 8px 12px;\n  border: 1px solid rgba(253, 184, 42, .5);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, .56);\n  color: rgba(21, 24, 29, .74);\n  font-size: 12px;\n  font-weight: 900;\n}\n\n@media (max-width: 1180px) {\n  .news-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 680px) {\n  .news-filter {\n    min-width: 0;\n    flex: 1 1 120px;\n  }\n\n  .news-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .news-card {\n    border-radius: 22px;\n  }\n}"
 },
 "attributes": {
  "class": "news-grid",
  "aria-label": "Новости и акции Golden House"
 },
 "layoutMode": "grid",
 "elementType": "container"
}
