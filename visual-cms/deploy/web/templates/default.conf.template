# =============================================================================
# Rendered at container start by the nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. ONLY the variables listed in
# NGINX_ENVSUBST_FILTER (docker-compose.production.yml) are substituted —
# nginx's own $variables are left untouched.
# Values come from visual-cms/.env. Do not put secrets anywhere else.
# =============================================================================

# Public news feed: 10 req/s per client IP (used in snippets/site.conf).
limit_req_zone $binary_remote_addr zone=news_public:10m rate=10r/s;

# Media cache in front of MinIO. Object URLs carry a storage uuid and never
# change content, so a long TTL is safe.
proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=media:32m
                 max_size=${MEDIA_CACHE_MAX_SIZE} inactive=30d use_temp_path=off;

# Per-environment values as nginx variables, so snippets/site.conf stays static.
# Empty header value = header not sent (prod: indexable; test: "noindex, nofollow").
map $host $gh_robots_tag      { default "${ROBOTS_TAG}"; }
map $host $gh_hsts            { default "${HSTS}"; }
# Write tokens for estate/news admin APIs: injected here, never reach the browser.
map $host $estate_write_token { default "${ESTATE_WRITE_TOKEN}"; }
map $host $news_write_token   { default "${NEWS_WRITE_TOKEN}"; }

server {
    listen 80;
    server_name ${SITE_DOMAIN} ${SITE_DOMAIN_ALIASES};

    # Container healthcheck (docker-compose.production.yml).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Let's Encrypt HTTP-01 (certbot --webroot -w ./certbot-www), see DEPLOY.md.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN} ${SITE_DOMAIN_ALIASES};

    # ./ssl on the host (not in git): server.crt = full chain, server.key = key.
    ssl_certificate     /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;

    include /etc/nginx/snippets/site.conf;
}
