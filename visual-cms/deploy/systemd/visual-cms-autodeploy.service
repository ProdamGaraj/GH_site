# Installed by deploy/scripts/install.sh (@USER@ / @CMS_DIR@ are substituted).
[Unit]
Description=Visual CMS auto-deploy (git pull → docker compose build/up)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@CMS_DIR@
ExecStart=/bin/bash @CMS_DIR@/deploy/scripts/autodeploy.sh
# A full rebuild + healthchecks + possible rollback fits well within this.
TimeoutStartSec=45min
Nice=5
