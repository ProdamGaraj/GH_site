# =============================================================================
# Visual CMS — server settings for docker-compose.production.yml.
#
#   cp .env.example .env
#   deploy/scripts/secrets.sh init     # fills every empty secret with a random value
#
# .env is gitignored. Keep a copy of the filled file in a password manager:
# without ENCRYPTION_KEY the stored data-source credentials cannot be decrypted.
# Format: KEY=value, no quotes; the value runs to the end of the line (both
# docker compose and deploy/scripts read it that way).
# =============================================================================

# Plain `docker compose …` in this directory uses the production stack.
COMPOSE_FILE=docker-compose.production.yml

# ----------------------------------------------------------------- site
# Primary domain (server_name, PUBLIC_SITE_URL, cookies). Test: test_analytics.gh.uz
SITE_DOMAIN=gh.uz
# Extra server names, space-separated (e.g. www.gh.uz). Optional.
SITE_DOMAIN_ALIASES=
# Test stand: ROBOTS_TAG=noindex, nofollow  and  PUBLIC_SITE_NOINDEX=true
ROBOTS_TAG=
PUBLIC_SITE_NOINDEX=false
# HSTS header value. Delete the line for the default (1 year); set it empty
# (HSTS=) on a host whose certificate browsers do not trust.
#HSTS=max-age=31536000
HTTP_PORT=80
HTTPS_PORT=443
MEDIA_CACHE_MAX_SIZE=10g
LOG_LEVEL=info

# -------------------------------------------- secrets (secrets.sh init)
# Hex values only — they are embedded in connection URLs.
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=cms-media-admin
MINIO_ROOT_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
ESTATE_WRITE_TOKEN=
NEWS_WRITE_TOKEN=
# First CMS admin (created only if there are no users yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ------------------------------------------------------ integrations
MACRO_BASE_URL=https://api.macrocrm.gh.uz/v2
MACRO_TOKEN=
MACRO_APP_ID=
MACRO_SYNC_COLLECTIONS=
MACRO_SYNC_MEDIA_SITE_ID=
MACRO_SYNC_MEDIA_FOLDER_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------- auto-deploy (DEPLOY.md §6)
DEPLOY_BRANCH=master
# 1 = deploy only commits whose GitHub checks are all green (needs GITHUB_TOKEN
# with read access to the repo's checks; fine-grained "Checks: read").
DEPLOY_REQUIRE_CI=0
GITHUB_REPO=ProdamGaraj/GH_site
GITHUB_TOKEN=
# Dump the databases right before every deploy (recommended).
DEPLOY_PRE_BACKUP=1
# Optional Telegram notifications about deploys and backups.
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ----------------------------------------------- backups (DEPLOY.md §7)
# Relative paths are relative to this directory.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
# Media archives are big: keep fewer.
BACKUP_MEDIA_KEEP_DAYS=7
# Optional off-site copy: an rclone remote path, e.g. s3backup:gh-backups
BACKUP_RCLONE_REMOTE=
